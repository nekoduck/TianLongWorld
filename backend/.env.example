# ============================================================
#  复制为 backend/.env 后生效。默认 mock：零密钥即可跑通整条管线。
# ============================================================

# mock | gemini | openai | anthropic
LLM_PROVIDER=mock

# ---- Gemini（推荐：原生结构化输出，约 5s/回合）-------------------
# LLM_PROVIDER=gemini
# LLM_API_KEY=...
# LLM_MODEL=gemini-flash-latest
# 思考档位 low | medium | high，留空用模型默认（更慢）
# LLM_THINKING_LEVEL=low

# ---- Anthropic -------------------------------------------------
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5-5

# ---- OpenAI 兼容协议（OpenAI / DeepSeek / 通义 / Ollama）---------
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1
#   Ollama: LLM_BASE_URL=http://localhost:11434/v1  （LLM_API_KEY 填任意非空值）

# 留空则使用 provider 默认温度
# LLM_TEMPERATURE=0.9
# LLM_TIMEOUT=60
# LLM_MAX_TOKENS=4096

# 仅 openai 兼容：端点不支持 json_schema 严格模式（如 DeepSeek）时设 false，退回 json_object
# LLM_STRICT_SCHEMA=true

# ---- 事件库 / 记忆 / HTTP --------------------------------------
# 事件日志（SQLite，只追加）；相对 backend/，进程重启后会话照常延续
# DATABASE_PATH=data/tianlong.db
# 滑动窗口：喂给导演的最近回合原文，限定 3~5
# HISTORY_TURNS=4
# JIT 检索：每回合最多注入的相关世界大事条数，限定 1~20
# MEMORY_LIMIT=8
# CORS_ORIGINS=["http://localhost:5173"]
