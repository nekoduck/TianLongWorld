# ============================================================
#  复制为 backend/.env 后生效。默认 mock：零密钥即可跑通整条管线。
# ============================================================

# mock | gemini | openai | anthropic
LLM_PROVIDER=mock

# ---- Gemini（推荐：原生结构化输出，约 5s/回合）-------------------
# LLM_PROVIDER=gemini
# LLM_API_KEY=...
# LLM_MODEL=gemini-flash-latest
# 思考档位 low | medium | high，留空用模型默认（更慢）
# LLM_THINKING_LEVEL=low

# ---- Anthropic -------------------------------------------------
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5-5

# ---- OpenAI 兼容协议（OpenAI / DeepSeek / 通义 / Ollama）---------
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1
#   Ollama: LLM_BASE_URL=http://localhost:11434/v1  （LLM_API_KEY 填任意非空值）

# 留空则使用 provider 默认温度
# LLM_TEMPERATURE=0.9
# LLM_TIMEOUT=60
# LLM_MAX_TOKENS=2048

# ---- 会话 / 上下文 / HTTP --------------------------------------
# SESSION_CAPACITY=1000
# 滑动窗口：喂给导演的最近回合原文，限定 3~5
# HISTORY_TURNS=4
# RAG 关系图：每回合至多注入的关系网行数（台账大事 + 原著关系），限定 1~30
# GRAPH_LIMIT=12
# RAG 语义检索：每回合至多注入的相关往事与江湖常识条数，限定 1~10
# SEMANTIC_TOP_K=3
# CORS_ORIGINS=["http://localhost:5173"]
