chr:进喜儿", `props`: {`kind`: "主仆", `note`: "进喜儿是听从钟万仇差遣做事的下人。"}}, {`a`: "chr:钟万仇", `b`: "chr:来福儿", `props`: {`kind`: "主仆", `note`: "来福儿是受钟万仇吩咐去庄外迎客的仆役。"}}, {`a`: "chr:钟万仇", `b`: "chr:甘宝宝", `props`: {`kind`: "亲族", `note`: "二人为夫妻，钟万仇极度紧张妻子，甚至不惜以死相胁。"}}, {`a`: "chr:钟万仇", `b`: "chr:段誉", `props`: {`kind`: "仇敌", `note`: "钟万仇极其多疑，痛骂并踢伤好心帮忙的段誉。"}}, {`a`: "chr:平婆婆", `b`: "chr:来福儿", `props`: {`kind`: "仇敌", `note`: "平婆婆在厅堂内出手杀害了来福儿。"}}, {`a`: "chr:干光豪", `b`: "chr:段誉", `props`: {`kind`: "仇敌", `note`: "干光豪为防行藏败露，拔剑欲斩杀段誉灭口。"}}, {`a`: "chr:天山童姥", `b`: "chr:司空玄", `props`: {`kind`: "主仆", `note`: "司空玄自称属下，奉灵鹫宫号令行事。"}}, {`a`: "chr:干光豪", `b`: "chr:葛光佩", `props`: {`kind`: "同门", `note`: "两人同为无量剑叛徒，结伴叛逃。"}}, {`a`: "chr:瑞婆婆", `b`: "chr:木婉清", `props`: {`kind`: "仇敌", `note`: "一路阴魂不散地追踪并围攻木婉清。"}}, {`a`: "chr:平婆婆", `b`: "chr:木婉清", `props`: {`kind`: "仇敌", `note`: "一路追踪木婉清，大叫要杀了她。"}}, {`a`: "chr:木婉清", `b`: "chr:秦红棉", `props`: {`kind`: "师徒", `note`: "幽谷客是木婉清的师父，传授武功并让其立下毒誓。"}}, {`a`: "chr:南海鳄神", `b`: "chr:孙三霸", `props`: {`kind`: "师徒", `note`: "孙三霸是岳老二心爱的徒弟，一身本领尚未学成。"}}, {`a`: "chr:木婉清", `b`: "chr:孙三霸", `props`: {`kind`: "仇敌", `note`: "孙三霸试图探看木婉清容貌，被木婉清出手杀害。"}}, {`a`: "chr:南海鳄神", `b`: "chr:进喜儿", `props`: {`kind`: "仇敌", `note`: "进喜儿因言语冒犯，被岳老二活活扭断脖子。"}}, {`a`: "chr:木婉清", `b`: "chr:段誉", `props`: {`kind`: "情侣", `note`: "木婉清依毒誓认段誉为丈夫，二人在崖上亲吻。"}}, {`a`: "chr:甘宝宝", `b`: "chr:木婉清", `props`: {`kind`: "同门", `note`: "甘宝宝是木婉清师父的师妹，即其师叔。"}}, {`a`: "chr:南海鳄神", `b`: "chr:叶二娘", `props`: {`kind`: "结义", `note`: "同列四大恶人，彼此以姊弟相称，却为排名争执不休。"}}, {`a`: "chr:南海鳄神", `b`: "chr:恶贯满盈", `props`: {`kind`: "结义", `note`: "同列四大恶人，南海鳄神打不过老大，只得听他的话。"}}, {`a`: "chr:恶贯满盈", `b`: "chr:叶二娘", `props`: {`kind`: "结义", `note`: "同列四大恶人，结义为兄妹。"}}, {`a`: "chr:恶贯满盈", `b`: "chr:云中鹤", `props`: {`kind`: "结义", `note`: "同列四大恶人，结义为兄弟。"}}, {`a`: "chr:叶二娘", `b`: "chr:云中鹤", `props`: {`kind`: "结义", `note`: "同列四大恶人，言语多有交锋。"}}, {`a`: "chr:南海鳄神", `b`: "chr:云中鹤", `props`: {`kind`: "结义", `note`: "同列四大恶人，结为兄弟共同行事。"}}, {`a`: "chr:左子穆", `b`: "chr:左山山", `props`: {`