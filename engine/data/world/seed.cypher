UNWIND [{`id`: "chr:辛双清", `props`: {`name`: "辛双清", `aliases`: ["双清"], `faction`: "“无量剑”西宗", `status`: "健在", `tier`: "三流", `disposition`: "中庸", `description`: "无量剑西宗掌门，道号双清。性格沉稳冷面，对东宗的得意之态颇为不满。"}}, {`id`: "chr:左子穆", `props`: {`name`: "左子穆", `aliases`: ["左先生"], `faction`: "“无量剑”东宗", `status`: "健在", `tier`: "二流", `disposition`: "中庸", `description`: "无量剑东宗掌门，剑法造诣极高，因门下弟子在比剑中连胜而神情得意。"}}, {`id`: "chr:马五德", `props`: {`name`: "马五德", `aliases`: ["马五爷"], `faction`: "", `status`: "健在", `tier`: "不入流", `disposition`: "中庸", `description`: "滇南普洱的富商兼老武师，生性随和好客，武功平平，带段誉同来观礼。"}}, {`id`: "chr:段誉", `props`: {`name`: "段誉", `aliases`: ["段大哥", "段少侠", "和誉", "段公子"], `faction`: "大理段氏", `status`: "健在", `tier`: "不入流", `disposition`: "仁厚", `description`: "大理国的斯文青年，因不懂武功而频出狂言，面对他人武功威胁亦毫无惧色。"}}, {`id`: "chr:龚光杰", `props`: {`name`: "龚光杰", `aliases`: [], `faction`: "“无量剑”东宗", `status`: "健在", `tier`: "三流", `disposition`: "狠辣", `description`: "左子穆门下的东宗弟子，脾气暴躁，行事凶狠，用剑法虚招侥幸获胜。"}}, {`id`: "chr:容子矩", `props`: {`name`: "容子矩", `aliases`: [], `faction`: "无量剑东宗", `status`: "已故", `tier`: "三流", `disposition`: "中庸", `description`: "左子穆的师弟，被神农帮所害，胸口被剧毒写有诛灭字样。"}}, {`id`: "chr:干光豪", `props`: {`name`: "干光豪", `aliases`: [], `faction`: "无量剑东宗", `status`: "健在", `tier`: "三流", `disposition`: "狠辣", `description`: "无量剑东宗大弟子，随师父命出厅查探，目睹师弟毒发倒地。"}}, {`id`: "chr:司空玄", `props`: {`name`: "司空玄", `aliases`: ["司空帮主", "山羊胡子"], `faction`: "神农帮", `status`: "健在", `tier`: "三流", `disposition`: "狠辣", `description`: "神农帮帮主，身中生死符，欲强占无量剑宫以求通天草治病止痛。"}}, {`id`: "chr:天山童姥", `props`: {`name`: "天山童姥", `aliases`: ["童姥"], `faction`: "缥缈峰灵鹫宫", `status`: "健在", `tier`: "三流", `disposition`: "中庸", `description`: "灵鹫宫掌事人，唯一能解生死符之毒的神秘莫测的人物。"}}, {`id`: "chr:钟灵", `props`: {`name`: "钟灵", `aliases`: ["灵儿", "钟姑娘"], `faction`: "", `status`: "健在", `tier`: "不入流", `disposition`: "中庸", `description`: "随身养有闪电貂的娇美少女，与段誉一同逃出险境，于男女之事似懂非懂。"}}, {`id`: "chr:孟述圣", `props`: {`name`: "孟述圣", `aliases`: ["继儒"], `faction`: "", `status`: "健在", `tier`: "不入流", `disposition`: "中庸", `description`: "段誉的受业师父，专研易理及说卦、系辞之学。"}}, {`id`: "chr:阿胜", `props`: {`name`: "阿胜", `aliases`: [], `faction`: "神农帮", `status`: "健在", `tier`: "三流", `disposition`: "中庸", `description`: "听命于司空玄的神农帮大汉，反手拿住了段誉。"}}, {`id`: "chr:阿洪", `props`: {`name`: "阿洪", `aliases`: [], `faction`: "神农帮", `status`: "健在", `tier`: "三流", `disposition`: "中庸", `description`: "奉命拿人的神农帮大汉，被钟灵以连招打中下颏摔出。"}}, {`id`: "chr:无涯子", `props`: {`name`: "无涯子", `aliases`: [], `faction`: "", `status`: "健在", `tier`: "不入流", `disposition`: "中庸", `description`: "曾居密洞，在石壁上以深厚内力刻下多篇庄子文章。"}}, {`id`: "chr:秋水妹", `props`: {`name`: "秋水妹", `aliases`: ["神仙姊姊"], `faction`: "逍遥派", `status`: "已故", `tier`: "三流", `disposition`: "狠辣", `description`: "曾在密洞留下白玉雕像与秘籍卷轴，遗言命传人杀尽逍遥派。"}}, {`id`: "chr:崔百泉", `props`: {`name`: "崔百泉", `aliases`: ["霍先生", "金算盘"], `faction`: "伏牛派", `status`: "健在", `tier`: "三流", `disposition`: "狠辣", `description`: "大理国账房先生，曾与段誉研习对弈之术。"}}, {`id`: "chr:甘宝宝", `props`: {`name`: "甘宝宝", `aliases`: ["钟夫人", "俏药叉"], `faction`: "万仇谷", `status`: "健在", `tier`: "三流", `disposition`: "中庸", `description`: "钟灵的母亲，容貌清秀，听闻段誉姓段后神色有异。"}}, {`id`: "chr:阿宝", `props`: {`name`: "阿宝", `aliases`: [], `faction`: "", `status`: "健在", `tier`: "不入流", `disposition`: "狠辣", `description`: "钟万仇之妻，钟灵之母，貌美且身负武功，言语间表露出杀人如草芥的狠劲。"}}, {`id`: "chr:钟万仇", `props`: {`name`: "钟万仇", `aliases`: ["见人就杀"], `faction`: "万仇谷", `status`: "健在", `tier`: "三流", `disposition`: "狠辣", `description`: "谷主，面貌丑陋，脾气暴躁且极度畏妻，对段正淳怀有深仇大恨。"}}, {`id`: "chr:进喜儿", `props`: {`name`: "进喜儿", `aliases`: [], `faction`: "万仇谷", `status`: "已故", `tier`: "三流", `disposition`: "中庸", `description`: "钟家的下人，因未能合乎岳老三的脾胃而惨遭扭断脖颈而死。"}}, {`id`: "chr:南海鳄神", `props`: {`name`: "南海鳄神", `aliases`: ["岳老三", "岳老二", "岳老大", "凶神恶煞"], `faction`: "四大恶人", `status`: "健在", `tier`: "一流", `disposition`: "狠辣", `description`: "四大恶人之一，行事疯癫暴躁，一言不合便出手草菅人命。"}}, {`id`: "chr:来福儿", `props`: {`name`: "来福儿", `aliases`: [], `faction`: "", `status`: "健在", `tier`: "不入流", `disposition`: "中庸", `description`: "钟家的下人，随进喜儿前往北庄迎客，目睹了同伴被杀的惨