d`: "兵器", `description`: "叶二娘的兵刃，曾逼得朱丹臣、古笃诚渐渐不支。", `canon_holder`: "chr:叶二娘"}}, {`id`: "itm:大环刀", `props`: {`name`: "大环刀", `aliases`: [], `kind`: "兵器", `description`: "钟万仇冲出屋来警告段正淳时手中所握的刀。", `canon_holder`: "chr:钟万仇"}}, {`id`: "itm:铁木鱼", `props`: {`name`: "铁木鱼", `aliases`: [], `kind`: "法器", `description`: "黄眉僧左手所持、约有饭碗大小的铁铸木鱼。", `canon_holder`: "chr:黄眉僧"}}, {`id`: "itm:小铁槌", `props`: {`name`: "小铁槌", `aliases`: ["木鱼槌"], `kind`: "法器", `description`: "钢铁铸成的木鱼槌，黄眉僧用它在青石上刻线落子。", `canon_holder`: "chr:黄眉僧"}}, {`id`: "itm:钢斧", `props`: {`name`: "钢斧", `aliases`: [], `kind`: "兵器", `description`: "古笃诚的兵器，几下就把树墙大树一株株砍断。", `canon_holder`: "chr:古笃诚"}}, {`id`: "itm:金盒", `props`: {`name`: "金盒", `aliases`: [], `kind`: "信物", `description`: "段正淳当年赠甘宝宝的定情之物，盒中红纸写着钟灵生辰", `canon_holder`: "chr:木婉清"}}, {`id`: "itm:黄金算盘", `props`: {`name`: "黄金算盘", `aliases`: [], `kind`: "暗器", `description`: "崔百泉随身的金铸算盘，暗藏机关，可弹射算珠伤人", `canon_holder`: "chr:崔百泉"}}, {`id`: "itm:青石棋局", `props`: {`name`: "青石棋局", `aliases`: [], `kind`: "棋局", `description`: "段延庆震裂的石刻棋盘，黄眉僧把碎块重新拼起", `canon_holder`: "loc:万劫谷"}}] AS row MERGE (n:Item {id: row.id}) SET n += row.props;
