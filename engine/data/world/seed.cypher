// TLBB-Engine 原著播种脚本：由 app/infrastructure/cypher.py 自蓝图确定性生成，请勿手改
CREATE CONSTRAINT location_id IF NOT EXISTS FOR (n:Location) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT character_id IF NOT EXISTS FOR (n:Character) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT martialart_id IF NOT EXISTS FOR (n:MartialArt) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT item_id IF NOT EXISTS FOR (n:Item) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT player_id IF NOT EXISTS FOR (n:Player) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT faction_name IF NOT EXISTS FOR (n:Faction) REQUIRE n.name IS UNIQUE;
CREATE INDEX item_canon_holder IF NOT EXISTS FOR (n:Item) ON (n.canon_holder);
CREATE INDEX held_by_world IF NOT EXISTS FOR ()-[r:HELD_BY]-() ON (r.world);
