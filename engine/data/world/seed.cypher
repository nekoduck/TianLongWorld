 "仇敌", `note`: "叶二娘偷袭得手，令高昇泰受了内伤"}}, {`a`: "chr:段正明", `b`: "chr:段誉", `props`: {`kind`: "亲族", `note`: "伯父与侄儿，段誉私自出走最怕伯父责罚"}}, {`a`: "chr:段正明", `b`: "chr:段正淳", `props`: {`kind`: "亲族", `note`: "兄弟，段正淳称皇帝为大哥"}}, {`a`: "chr:段正淳", `b`: "chr:褚万里", `props`: {`kind`: "主仆", `note`: "褚万里为镇南王牵马服侍"}}, {`a`: "chr:南海鳄神", `b`: "chr:段正淳", `props`: {`kind`: "仇敌", `note`: "南海鳄神闯府抢人，被段正淳挥掌挡回"}}, {`a`: "chr:段誉", `b`: "chr:南海鳄神", `props`: {`kind`: "师徒", `note`: "南海鳄神赌输，连磕八个响头拜段誉为师"}}, {`a`: "chr:段正淳", `b`: "chr:秦红棉", `props`: {`kind`: "情侣", `note`: "十八年前的恋人，秦红棉恨他负心薄幸"}}, {`a`: "chr:段正淳", `b`: "chr:木婉清", `props`: {`kind`: "亲族", `note`: "父女，段正淳亲口相认"}}, {`a`: "chr:秦红棉", `b`: "chr:刀白凤", `props`: {`kind`: "仇敌", `note`: "秦红棉恨刀白凤误她一生，命徒儿取其性命"}}, {`a`: "chr:木婉清", `b`: "chr:刀白凤", `props`: {`kind`: "仇敌", `note`: "木婉清奉师命在宴席上发毒箭射她"}}, {`a`: "chr:秦红棉", `b`: "chr:甘宝宝", `props`: {`kind`: "同门", `note`: "甘宝宝是木婉清的师叔，与秦红棉同出一门"}}, {`a`: "chr:段正淳", `b`: "chr:甘宝宝", `props`: {`kind`: "情侣", `note`: "旧日恋人，她如今已嫁钟万仇"}}, {`a`: "chr:恶贯满盈", `b`: "chr:段正明", `props`: {`kind`: "仇敌", `note`: "恶贯满盈自称与段正明仇深似海"}}, {`a`: "chr:段正明", `b`: "chr:巴天石", `props`: {`kind`: "主仆", `note`: "君臣，巴天石奉旨查探万劫谷"}}, {`a`: "chr:恶贯满盈", `b`: "chr:段誉", `props`: {`kind`: "仇敌", `note`: "将段誉囚禁并下春药，欲令段氏蒙羞绝后。"}}, {`a`: "chr:段廉义", `b`: "chr:恶贯满盈", `props`: {`kind`: "亲族", `note`: "父子，延庆太子是上德帝唯一的亲生儿子。"}}, {`a`: "chr:段寿辉", `b`: "chr:段廉义", `props`: {`kind`: "亲族", `note`: "叔侄，段寿辉在上德帝遇害后平乱继位。"}}, {`a`: "chr:段寿辉", `b`: "chr:段正明", `props`: {`kind`: "亲族", `note`: "堂兄弟，段寿辉出家前把帝位传给段正明。"}}, {`a`: "chr:杨义贞", `b`: "chr:段廉义", `props`: {`kind`: "仇敌", `note`: "杨义贞弑杀上德帝，图谋篡位。"}}, {`a`: "chr:高智昇", `b`: "chr:高昇泰", `props`: {`kind`: "亲族", `note`: "父子，高昇泰以先父忠君为由力谏。"}}, {`a`: "chr:黄眉僧", `b`: "chr:破疑", `props`: {`kind`: "师徒", `note`: "破疑是黄眉僧的大弟子，随侍在侧。"}}, {`a`: "chr:黄眉僧", `b`: "chr:恶贯满盈", `props`: {`kind`: "仇敌", `note`: "为救段誉，黄眉僧找上延庆太子以棋局较量。"}}, {`a`: "chr:华赫艮", `b`: "chr:范骅", `props`: {`kind`: "结义", `note`: "生死之交，以大哥二弟相称。"}}, {`a`: "chr:华赫艮", `b`: "chr:巴天石", `props`: {`kind`: "结义", `note`: "生死之交，三人以兄弟相称，同去挖地道。"}}, {`a`: "chr:范骅", `b`: "chr:巴天石", `props`: {`kind`: "结义", `note`: "生死之交，巴天石称范骅为二哥。"}}, {`a`: "chr:段正明", `b`: "chr:高昇泰", `props`: {`kind`: "主仆", `note`: "君臣，高昇泰拒绝奉行让位之议。"}}, {`a`: "chr:段正明", `b`: "chr:华赫艮", `props`: {`kind`: "主仆", `note`: "君臣，华赫艮辅佐保定帝屡立奇功。"}}, {`a`: "chr:黄眉僧", `b`: "chr:破嗔", `props`: {`kind`: "师徒", `note`: "破嗔是黄眉僧的二弟子，暗中为师父传递棋步。"}}, {`a`: "chr:云中鹤", `b`: "chr:钟万仇", `props`: {`kind`: "仇敌", `note`: "云中鹤扬言要夺钟家妻财，钟万仇约他事后较量。"}}, {`a`: "chr:段正淳", `b`: "chr:古笃诚", `props`: {`kind`: "主仆", `note`: "段正淳命古笃诚砍树开路。"}}, {`a`: "chr:段正淳", `b`: "chr:钟灵", `props`: {`kind`: "亲族", `note`: "钟灵是他的私生女"}}, {`a`: "chr:柯百岁", `b`: "chr:过彦之", `props`: {`kind`: "师徒", `note`: "过彦之是其大弟子"}}, {`a`: "chr:柯百岁", `b`: "chr:崔百泉", `props`: {`kind`: "同门", `note`: "师兄弟"}}, {`a`: "chr:玄慈", `b`: "chr:玄悲", `props`: {`kind`: "同门", `note`: "师兄弟"}}, {`a`: "chr:玄悲", `b`: "chr:慧真", `props`: {`kind`: "师徒", `note`: "慧真称玄悲为师父"}}, {`a`: "chr:玄悲", `b`: "chr:慧观", `props`: {`kind`: "师徒", `note`: "慧观随师南来"}}, {`a`: "chr:慧真", `b`: "chr:慧观", `props`: {`kind`: "同门", `note`: "师兄弟"}}, {`a`: "chr:崔百泉", `b`: "chr:吕庆图", `props`: {`kind`: "仇敌", `note`: "崔百泉杀其满门"}}, {`a`: "chr:柯百岁", `b`: "chr:吕庆图", `props`: {`kind`: "仇敌", `note`: "柯百岁对其切齿痛恨"}}, {`a`: "chr:崔百泉", `b`: "chr:过彦之", `props`: {`kind`: "同门", `note`: "师叔与师侄"}}, {`a`: "chr:慕容博", `b`: "chr:崔百泉", `props`: {`kind`: "仇敌", `note`: "崔百泉认定他杀了自己师兄"}}, {`a`: "chr:南海鳄神", `b`: "chr:钟万仇", `props`: {`kind`: "仇敌", `note`: "为辈分之争要杀钟万仇"}}] AS row MATCH (a:Character {id: row.a}) MATCH (b:Character {id: row.b}) MERGE (a)-[r:HAS_RELATION]->(b) SET r += row.props;
UNWIND [{`a`: "art:北冥神功", `b`: "itm:帛卷", `props`: {`as`: "item"}}, {`a`: "art:凌波微步", `b`: "itm:帛卷", `props`: {`as`: "item"}}] AS row MATCH (a:MartialArt {id: row.a}) MATCH (b:Item {id: row.b}) MERGE (a)-[r:REQUIRES]->(b) SET r += row.props;
