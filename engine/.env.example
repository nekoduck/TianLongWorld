# ============================================================
#  复制为 engine/.env 后生效。默认全内存 + mock：零依赖、零密钥即可跑通整条管线
#  （mock 下意图解析与叙事退化为确定性的离线实现；原著抽取与图谱自愈由 Claude 子代理经 export / ingest 完成，不调用付费大模型）
# ============================================================

# ---- 大模型：mock | anthropic | gemini | openai ----------------
#  五种职责各取一套（模型, 思考档位）：LLM_{INTENT|NARRATION|EXTRACTION|RESOLUTION|AGENDA}_{MODEL|THINKING}，留空退回 LLM_MODEL / LLM_THINKING。
#  思考档位 minimal | low | medium | high：Gemini 映射为 thinkingLevel，Anthropic 映射为 effort（minimal 按 low），openai 兼容端忽略
LLM_PROVIDER=mock

# ---- 推荐：Gemini（2026-10 实测选型，见 engine/README.md「模型选型」）----
# LLM_PROVIDER=gemini
# LLM_API_KEY=...
# LLM_MODEL=gemini-3.8-flash
# LLM_THINKING=low
# 意图解析要快：约 1s/次，最守"规整为正名"的纪律
# LLM_INTENT_MODEL=gemini-3.1-flash-lite
# LLM_INTENT_THINKING=minimal
# 叙事要忠于快照：首字约 1.7s，玩家声称持有的东西不在行囊就写空手（flash-lite 会被话术带偏）
# LLM_NARRATION_MODEL=gemini-3.8-flash
# LLM_NARRATION_THINKING=low
# 原著抽取与图谱自愈不归付费大模型：由 Claude 子代理经 seed export / ingest、heal --export / --ingest 完成。
# 下面两行只在 seed extract / heal 显式带 --use-llm 时生效（2026-10 实测：gemini-3.1-pro 约 35s/块、每天 250 次请求，
# 两次跑空预付额度——抽取与自愈因此改由 Claude 子代理承担）
# LLM_EXTRACTION_MODEL=gemini-3.1-pro-preview
# LLM_EXTRACTION_THINKING=high
# 地下城主裁决胜负未定的出手（只在可裁区间里挑结局与伤势，失灵或超出时间预算即由规则裁决）：在命令侧玩家锁内同步调用，
# 直接计入出手回合的延迟。2026-10 实测（14 场景 × 3 次）：gemini-3.8-flash + low p50 2.8s / p90 3.9s，首发采纳 100%，速写零硬伤、
# 守住"仁厚者手下留情"；flash-lite 系快一倍但不守性情；3.1-pro 太慢（p50 6s）且配额紧。
# gemini-3.8-flash 不收 minimal——会返回 HTTP 400，地下城主整个退回规则裁决（玩家无感，只在日志里看得到）
# LLM_RESOLUTION_MODEL=gemini-3.8-flash
# LLM_RESOLUTION_THINKING=low
# 时间预算（秒）管整场裁决：越界重采样不另领一份，超时即由规则裁决
# LLM_RESOLUTION_BUDGET=8
# 撞见与狭路相逢的判官共用地下城主职责（同一套模型、思考档位与 LLM_RESOLUTION_BUDGET）：只在 NPC 行军撞上玩家、
# 或两位开篇仇人狭路相逢时请，每回合至多一场；其余的中断与判官失灵时一律取确定性裁决（撞见只记驻足，狭路相逢按境界 × 性情定胜负）
# 宏观议程（分层 NPC 生态的战略层）：为有执念的核心 NPC 立「去哪、为何、多要紧」，只在初临江湖、跨进新的一日、
# 或冷却两个时辰后江湖震动（重伤、身死、狭路相逢动了手）时请一次；寻路行军与相撞检测是纯函数，从不调大模型。
# 议程要懂人设与局部情报，不在玩家锁的热路径上频繁出现，flash + low 足够
# LLM_AGENDA_MODEL=gemini-3.8-flash
# LLM_AGENDA_THINKING=low
# 时间预算（秒）管整轮议程推演（不合契约的一次重采样不另领一份），超时即这一轮谁也不出门
# LLM_AGENDA_BUDGET=10
# 关掉即一条议程也不立（不花这份钱）：NPC 守在原处，撞见与狭路相逢自然也不会发生
# NPC_AGENDA=true
# 点选回合不请地下城主：胜负未定之事由气运按种子（玩家 | 对象 | 对该对象的尝试次数，不取版本号）在可裁区间里取结局——
# 确定性裁决 60% / 好一格 25% / 差一格 15%，绝不比确定性裁决更凶险；false 则点选一律取确定性裁决。两者都不调大模型
# FORTUNE_ON_CLICK=true

# ---- Anthropic：Claude 新模型拒收 temperature，保持 LLM_TEMPERATURE 留空 ----
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-5-5
# LLM_INTENT_THINKING=low

# ---- OpenAI 兼容协议（OpenAI / DeepSeek / 通义 / Ollama）----
# LLM_PROVIDER=openai
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1

# 调用次数保险丝：一个进程内各职责合计至多发出这么多次请求（一回合通常至多三次：意图 + 地下城主 + 叙事；
# 撞见 / 狭路相逢的判官每回合至多再一次，议程一日至多一轮；500 次约两百回合），
# 熔断后地下城主与判官交给规则、议程谁也不立、叙事降级为白描、意图解析报错，重启进程即复位；0 = 不设上限
# LLM_CALL_LIMIT=500

# LLM_TEMPERATURE=
# LLM_TIMEOUT=120
# LLM_MAX_TOKENS=16000

# ---- 事件账本：memory | postgres -------------------------------
EVENT_STORE=memory
# EVENT_STORE=postgres
# POSTGRES_DSN=postgresql://tlbb:tlbb@localhost:5432/tlbb

# ---- 图谱快照：memory | neo4j ----------------------------------
#   memory 后端在启动时自动加载 data/world/blueprint.json
GRAPH_BACKEND=memory
# GRAPH_BACKEND=neo4j
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=tlbb-neo4j
# NEO4J_DATABASE=neo4j

# ---- 长线记忆：:memory: 为 qdrant-client 本地模式 ---------------
QDRANT_URL=:memory:
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=tlbb_memories
# 每回合注入叙事的记忆条数，限定 1~10
# MEMORY_RECALL_K=4

# ---- 原著播种 ---------------------------------------------------
# SOURCE_TEXT_DIR=data/source_text
# WORLD_DIR=data/world
# EXTRACTION_CHUNK_CHARS=6000
# EXTRACTION_CONCURRENCY=4
