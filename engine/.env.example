# ============================================================
#  复制为 engine/.env 后生效。默认全内存 + mock：零依赖、零密钥即可跑通整条管线
#  （mock 下意图解析与叙事退化为确定性的离线实现；原著解析必须接真实大模型）
# ============================================================

# ---- 大模型：mock | anthropic | gemini | openai ----------------
LLM_PROVIDER=mock
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-5-5
#   Claude 新模型拒收 temperature：保持留空；思考深度用 LLM_EFFORT（low | medium | high）
# LLM_EFFORT=low
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-flash-latest
# LLM_PROVIDER=openai
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_TEMPERATURE=
# LLM_TIMEOUT=120
# LLM_MAX_TOKENS=16000

# ---- 事件账本：memory | postgres -------------------------------
EVENT_STORE=memory
# EVENT_STORE=postgres
# POSTGRES_DSN=postgresql://tlbb:tlbb@localhost:5432/tlbb

# ---- 图谱快照：memory | neo4j ----------------------------------
#   memory 后端在启动时自动加载 data/world/blueprint.json
GRAPH_BACKEND=memory
# GRAPH_BACKEND=neo4j
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=tlbb-neo4j
# NEO4J_DATABASE=neo4j

# ---- 长线记忆：:memory: 为 qdrant-client 本地模式 ---------------
QDRANT_URL=:memory:
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=tlbb_memories
# 每回合注入叙事的记忆条数，限定 1~10
# MEMORY_RECALL_K=4

# ---- 原著播种 ---------------------------------------------------
# SOURCE_TEXT_DIR=data/source_text
# WORLD_DIR=data/world
# EXTRACTION_CHUNK_CHARS=6000
# EXTRACTION_CONCURRENCY=4
